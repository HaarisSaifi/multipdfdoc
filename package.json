{
  "name": "multipdfdoc",
  "version": "1.0.0",
  "description": "100% In-Browser Private Document Suite & PDF Utilities powered by WebAssembly (Zero Server Uploads)",
  "homepage": "https://multipdfdoc.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaarisSaifi/multipdfdoc.git"
  },
  "bugs": {
    "url": "https://github.com/HaarisSaifi/multipdfdoc/issues"
  },
  "author": "Haaris Saifi <support@multipdfdoc.com>",
  "license": "MIT",
  "keywords": [
    "pdf",
    "multipdf",
    "pdf-tools",
    "webassembly",
    "client-side",
    "zero-upload",
    "privacy-first",
    "qpdf",
    "tesseract-ocr",
    "pdf-merger",
    "pdf-compressor",
    "invoice-generator",
    "gpa-calculator"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs && next build",
    "start": "node scripts/serve-static.mjs",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "test": "node scripts/test-production.cjs && node scratch/test-core-invariants.js",
    "test:browser": "node scripts/test-browser.mjs",
    "postbuild": "node scripts/prepare-static.mjs",
    "package:hostinger": "node scripts/package-hostinger.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "pdfstudio": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.29"
    },
    "postcss-selector-parser": "7.1.6"
  }
}
