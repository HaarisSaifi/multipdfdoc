# These are build-time settings for the public static release. No API keys are needed.
GOOGLE_SITE_VERIFICATION=
# Keep ads off until real approval, applicable certified CMP and placement QA.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=

# Optional GA4: only loads after a visitor explicitly allows analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
