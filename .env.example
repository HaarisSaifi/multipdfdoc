# region eligibility and accurate retention disclosures. Keep disabled until verified.
CLOUD_OCR_ENABLED=false
NEXT_PUBLIC_CLOUD_OCR_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Do not enable until AdSense approval, consent/CMP configuration and ad QA.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
